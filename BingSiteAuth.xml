<?xml version="1.0" encoding="utf-8"?>
<BingSiteAuth>
  {%- comment -%} The same verify key Bing Webmaster Tools gives for the msvalidate.01
  meta tag, which site-head.html reads from the same `bing_verification` key in
  _config.yml. Empty until that key is set. The file must stay fetchable for
  verification, so robots.txt allows it and sitemap.xml never lists it (the sitemap
  loops the homepage and publications only). {%- endcomment -%}
  {%- if site.bing_verification %}<VerifyKey>{{ site.bing_verification }}</VerifyKey>{% endif %}
</BingSiteAuth>
